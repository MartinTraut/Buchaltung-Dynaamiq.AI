# ============================================================
# DYNAAMIQ OS — Environment
# Kopiere diese Datei zu .env.local und trage deine Keys ein.
# ============================================================

# --- KI-Assistent (Claude) ---
# Ohne Key läuft der Assistent im Demo-Modus (heuristische Antworten).
# Key holen: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: Modell überschreiben (Standard: claude-opus-4-8)
AI_MODEL=claude-opus-4-8

# --- Supabase (optional, für Cloud-Sync statt localStorage) ---
# Projekt anlegen: https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anmeldung (Pflicht) ---
# Ohne diese drei Werte kommt niemand ins Cockpit — der Proxy lässt im
# Zweifel keinen durch, statt versehentlich alle.
AUTH_USERNAME=
# In Anführungszeichen setzen, wenn das Passwort ein # enthält — sonst gilt
# alles ab dem # als Kommentar und das Passwort ist still abgeschnitten.
AUTH_PASSWORD=
# Zufälliger Signaturschlüssel für die Sitzungscookies, z. B. erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
